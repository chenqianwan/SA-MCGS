{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "proof_source_ids", "rationale"],
  "properties": {
    "label": {"type": "string", "enum": ["Entailed", "PR-Unknown"]},
    "proof_source_ids": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"}
  }
}

