#!/bin/bash
# LOCAL DRAFT ONLY. Resolve and verify all __PLACEHOLDERS__ before staging.
# No node is pinned: dgx081 availability and GPU type must be rechecked.
#SBATCH --job-name=chenlong_lea_qwen25_72b
#SBATCH --partition=llm
#SBATCH --qos=llm
#SBATCH --account=hansirui
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --gres=gpu:4
#SBATCH --mem=256G
#SBATCH --time=04:00:00
#SBATCH --chdir=/aifs4su/hansirui_3rd/chenlong/q72_20260923
#SBATCH --output=/aifs4su/hansirui_3rd/chenlong/q72_20260923/logs/slurm-%j.out
#SBATCH --error=/aifs4su/hansirui_3rd/chenlong/q72_20260923/logs/slurm-%j.err
#SBATCH --export=NONE

set -euo pipefail
umask 077
export PATH=/usr/bin:/bin
unset PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
export SLURM_CONF=/cm/shared/apps/slurm/var/etc/slurm/slurm.conf
export SLURM_EXPORT_ENV=ALL

readonly SERVICE_ROOT=/aifs4su/hansirui_3rd/chenlong/q72_20260923
readonly RUNTIME_ROOT=/aifs4su/hansirui/vllm-dsv4-venv
readonly MODEL_ROOT='__VERIFIED_QWEN25_72B_INSTRUCT_BF16_LOCAL_PATH__'
readonly CHECKPOINT_REVISION='__VERIFIED_IMMUTABLE_CHECKPOINT_REVISION__'
readonly CONFIG_SHA256='__VERIFIED_CONFIG_JSON_SHA256__'
readonly MODEL_ALIAS=qwen2.5-72b-instruct
readonly PORT=18072
readonly JOB_ROOT="$SERVICE_ROOT/runs/${SLURM_JOB_ID:?Slurm job required}"
readonly SHORT_TMP="$SERVICE_ROOT/t/${SLURM_JOB_ID}"

# Staging must create SERVICE_ROOT/logs before submission; Slurm opens those
# output files before executing this script. Do not write to shared runtime/model.
/usr/bin/python3 -B - "$SERVICE_ROOT" "$JOB_ROOT" "$SHORT_TMP" "$MODEL_ROOT" "$CHECKPOINT_REVISION" "$CONFIG_SHA256" "$PORT" <<'PY'
import hashlib, json, os, pathlib, socket, sys
root, run, temp, model = map(pathlib.Path, sys.argv[1:5])
revision, expected_config_hash = sys.argv[5:7]
allowed = pathlib.Path('/aifs4su/hansirui_3rd/chenlong')
if '__' in str(model) or '__' in revision or '__' in expected_config_hash:
    raise SystemExit('Draft placeholders remain: checkpoint path, immutable revision and config hash are required.')
if os.getuid() != 1083 or not os.environ['SLURM_JOB_ID'].isdigit():
    raise SystemExit('Expected hansirui_3rd (uid 1083) and a numeric Slurm job ID.')
for leaf in (root, root / 'logs', run, temp):
    if leaf.resolve() != leaf or allowed not in leaf.parents:
        raise SystemExit(f'Redirected or out-of-scope write path: {leaf}')
    for parent in (leaf, *leaf.parents):
        if (parent == allowed or allowed in parent.parents) and parent.exists():
            if not parent.is_dir() or parent.stat().st_uid != os.getuid():
                raise SystemExit(f'Unexpected output-directory owner/type: {parent}')
if not model.is_absolute() or not model.is_dir():
    raise SystemExit('Expected a verified local BF16 snapshot; downloads are disabled.')
config_raw = (model / 'config.json').read_bytes()
if hashlib.sha256(config_raw).hexdigest() != expected_config_hash:
    raise SystemExit('Checkpoint config differs from the verified snapshot.')
config = json.loads(config_raw)
if (config.get('model_type') != 'qwen2' or config.get('hidden_size') != 8192
    or config.get('num_hidden_layers') != 80
    or config.get('architectures') != ['Qwen2ForCausalLM']):
    raise SystemExit('Expected Qwen2.5-72B-Instruct architecture; confirm instruct identity via pinned snapshot.')
if config.get('torch_dtype', config.get('dtype')) != 'bfloat16' or config.get('quantization_config'):
    raise SystemExit('Expected unquantized BF16 weights.')
index = json.loads((model / 'model.safetensors.index.json').read_text())
shards = []
for name in sorted(set(index['weight_map'].values())):
    relative = pathlib.PurePosixPath(name)
    if relative.is_absolute() or '..' in relative.parts or not os.access(model / name, os.R_OK):
        raise SystemExit(f'Invalid/unreadable checkpoint shard: {name}')
    info = (model / name).stat()
    shards.append({'file': name, 'bytes': info.st_size, 'mtime_ns': info.st_mtime_ns})
if len(os.fsencode(temp / '00000000-0000-0000-0000-000000000000')) > 107:
    raise SystemExit('Temporary path exceeds the vLLM IPC socket limit.')
with socket.socket() as sock:
    sock.bind(('0.0.0.0', int(sys.argv[7])))
run.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
run.mkdir(mode=0o700)
temp.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
temp.mkdir(mode=0o700)
for name in ('cache/huggingface', 'cache/torch', 'cache/inductor', 'cache/triton',
             'cache/vllm', 'cache/numba', 'cache/cuda', 'cache/flashinfer',
             'cache/torch_extensions', 'cache/tvm-ffi', 'config'):
    (run / name).mkdir(parents=True, exist_ok=True, mode=0o700)
files = ('config.json', 'model.safetensors.index.json', 'tokenizer_config.json',
         'tokenizer.json', 'generation_config.json', 'chat_template.jinja')
fingerprints = {name: hashlib.sha256((model / name).read_bytes()).hexdigest()
                for name in files if (model / name).is_file()}
(run / 'checkpoint.json').write_text(json.dumps({
    'repository': 'Qwen/Qwen2.5-72B-Instruct', 'immutable_revision': revision,
    'local_path': str(model), 'precision': 'bfloat16', 'quantization': None,
    'metadata_sha256': fingerprints, 'shards': shards,
}, indent=2) + '\n')
PY

export TMPDIR="$SHORT_TMP" TMP="$SHORT_TMP" TEMP="$SHORT_TMP"
export XDG_CACHE_HOME="$JOB_ROOT/cache" XDG_CONFIG_HOME="$JOB_ROOT/config"
export HF_HOME="$JOB_ROOT/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub" HUGGINGFACE_HUB_CACHE="$HF_HOME/hub" HF_MODULES_CACHE="$HF_HOME/modules"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export TORCH_HOME="$JOB_ROOT/cache/torch" TORCHINDUCTOR_CACHE_DIR="$JOB_ROOT/cache/inductor"
export TRITON_CACHE_DIR="$JOB_ROOT/cache/triton" NUMBA_CACHE_DIR="$JOB_ROOT/cache/numba"
export VLLM_CACHE_ROOT="$JOB_ROOT/cache/vllm" VLLM_CONFIG_ROOT="$JOB_ROOT/config/vllm"
export CUDA_CACHE_PATH="$JOB_ROOT/cache/cuda" FLASHINFER_WORKSPACE_BASE="$JOB_ROOT/cache/flashinfer"
export TORCH_EXTENSIONS_DIR="$JOB_ROOT/cache/torch_extensions" TVM_FFI_CACHE_DIR="$JOB_ROOT/cache/tvm-ffi"
export FLASHINFER_NO_DOWNLOAD=1 VLLM_NO_USAGE_STATS=1 VLLM_DO_NOT_TRACK=1 DO_NOT_TRACK=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0 VLLM_RPC_TIMEOUT=1800000 VLLM_ENGINE_ITERATION_TIMEOUT_S=1800
export CUDA_HOME=/cm/shared/apps/cuda-12.8 CUDA_PATH=/cm/shared/apps/cuda-12.8
export LD_LIBRARY_PATH="$CUDA_HOME/lib64"
export PATH="$RUNTIME_ROOT/bin:$CUDA_HOME/bin:/usr/bin:/bin"
# Preserve the CUDA_VISIBLE_DEVICES assigned by Slurm; never select all 8 GPUs.

exec "$RUNTIME_ROOT/bin/python3" -B - "$SERVICE_ROOT" "$JOB_ROOT" "$MODEL_ROOT" "$MODEL_ALIAS" "$PORT" <<'PY'
import datetime, fcntl, importlib.metadata, json, os, pathlib, socket, subprocess, sys
root, run = map(pathlib.Path, sys.argv[1:3])
lock_fd = os.open(root / 'service.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
os.set_inheritable(lock_fd, True)
args = [sys.executable, '-B', '-m', 'vllm.entrypoints.openai.api_server',
    '--model', sys.argv[3], '--served-model-name', sys.argv[4],
    '--host', '0.0.0.0', '--port', sys.argv[5], '--dtype', 'bfloat16',
    '--tensor-parallel-size', '4', '--max-model-len', '16384', '--max-num-seqs', '8',
    '--gpu-memory-utilization', '0.90', '--generation-config', 'vllm',
    '--override-generation-config', '{"top_k":-1,"top_p":1.0,"repetition_penalty":1.0}',
    '--enforce-eager', '--no-async-scheduling']
gpu = subprocess.run(['nvidia-smi', '--query-gpu=index,name,memory.total,uuid',
    '--format=csv,noheader'], capture_output=True, text=True, check=True).stdout
record = {'status': 'starting', 'job_id': os.environ['SLURM_JOB_ID'],
    'created_at': datetime.datetime.now().astimezone().isoformat(),
    'hostname': socket.gethostname(), 'base_url': f'http://{socket.gethostname()}:{sys.argv[5]}/v1',
    'served_model_name': sys.argv[4], 'argv': args,
    'vllm_version': importlib.metadata.version('vllm'),
    'torch_version': importlib.metadata.version('torch'),
    'transformers_version': importlib.metadata.version('transformers'),
    'cuda_visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES'),
    'slurm_job_gpus': os.environ.get('SLURM_JOB_GPUS'), 'gpu_inventory': gpu,
    'tensor_parallel_size': 4, 'max_model_len': 16384, 'max_num_seqs': 8,
    'client_max_tokens_unchanged': 2048,
    'context_tokenization_validation': 'REQUIRED BEFORE EXPERIMENT CALLS'}
with (run / 'endpoint.json').open('x') as stream:
    json.dump(record, stream, indent=2)
    stream.write('\n')
print(json.dumps(record), flush=True)
log_fd = os.open(run / 'server.log', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
os.dup2(log_fd, 1)
os.dup2(log_fd, 2)
os.close(log_fd)
os.execv(sys.executable, args)
PY
